---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { NewsletterBox } from '../../components/InteractiveUI';
import { Calendar, ChevronRight, Tag } from 'lucide-react';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const uniqueCategories = [...new Set(allPosts.map((post) => post.data.category))];
  return uniqueCategories.map((category) => {
    const filteredPosts = allPosts.filter((post) => post.data.category === category);
    return {
      params: { category: category.toLowerCase() },
      props: { categoryName: category, posts: filteredPosts },
    };
  });
}

const { categoryName, posts } = Astro.props;
const sortedPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const allPostsGlobal = await getCollection('blog');
const allCategories = ["All", ...new Set(allPostsGlobal.map((post) => post.data.category))];
const catCounts = allPostsGlobal.reduce((acc, post) => {
    acc[post.data.category] = (acc[post.data.category] || 0) + 1;
    return acc;
}, {});

const BASE = "/anime-blog";
---

<Layout title={`AnimeFocus - ${categoryName}`} description={`Articles in ${categoryName}`}>
	<main class="max-w-5xl mx-auto px-6 py-12 w-full">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-12 animate-fade-in">
            <div class="md:col-span-8">
                <div class="mb-10 border-b border-gray-100 pb-6">
                    <a href={`${BASE}/`} class="text-sm font-medium text-gray-500 hover:text-black mb-4 inline-block transition-colors">← Back to All</a>
                    <h1 class="text-4xl font-bold text-gray-900">{categoryName}</h1>
                    <p class="text-gray-500 mt-2">{posts.length} Articles found</p>
                </div>
                <div class="flex flex-col gap-10">
                    {sortedPosts.map((post) => (
                        <a href={`${BASE}/blog/${post.slug}`} class="group cursor-pointer border-b border-gray-200 pb-10 last:border-0 block">
                            <div class="flex flex-col md:flex-row gap-6 items-start">
                                <div class="w-full md:w-32 md:h-32 rounded-xl bg-gray-100 relative overflow-hidden shrink-0">
                                    <img src={post.data.image} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                                </div>
                                <div class="flex-1 py-1">
                                    <div class="flex items-center gap-2 text-xs text-gray-500 font-medium uppercase tracking-wide mb-2">
                                        <span class="flex items-center gap-1"><Calendar size={12} /> {post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                                    </div>
                                    <h2 class="text-xl font-bold text-gray-900 group-hover:text-red-600 transition-colors leading-tight mb-2">
                                        {post.data.title}
                                    </h2>
                                    <p class="text-sm text-gray-600 line-clamp-2">
                                        {post.data.description}
                                    </p>
                                </div>
                                <div class="hidden md:block self-center text-gray-300 group-hover:text-black transition-colors">
                                    <ChevronRight size={20} />
                                </div>
                            </div>
                        </a>
                    ))}
                </div>
            </div>
            <aside class="md:col-span-4 md:pl-12 border-l border-gray-200 hidden md:block">
                <div class="sticky top-24 space-y-24">
                    <div class="p-6 rounded-2xl mb-12">
                        <h3 class="font-bold text-lg mb-4 flex items-center gap-2"><Tag size={18} /> Categories</h3>
                        <div class="flex flex-col gap-2">
                            {allCategories.slice(1).map(cat => (
                                <a href={`${BASE}/category/${cat.toLowerCase()}`} class={`flex justify-between items-center text-sm group cursor-pointer transition-colors ${cat === categoryName ? 'text-black font-bold' : 'text-gray-600 hover:text-black'}`}>
                                    <span>{cat}</span>
                                    <span class="bg-gray-200 text-gray-600 px-2 py-0.5 rounded-full text-xs font-bold group-hover:bg-black group-hover:text-white transition-colors">
                                        {catCounts[cat] || 0}
                                    </span>
                                </a>
                            ))}
                        </div>
                    </div>
                    <NewsletterBox client:load />
                </div>
            </aside>
        </div>
	</main>
</Layout>